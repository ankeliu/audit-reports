{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ankeliu/audit-reports/schema/index-schema.json",
  "title": "Stellar Audit Bank report archive index (reports/index.json)",
  "description": "Generated by `auditbank index`. Lists accepted reports only; intentionally carries no field that enables cross-firm comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "schema_version", "reports"],
  "properties": {
    "generated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "schema_version": {"type": "string"},
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "project_slug", "client", "audit_firm", "firm_abbrev", "report_date", "platform",
                     "disclosure_status", "conversion_method", "findings_summary", "pdf_url", "firm_report_url"],
        "properties": {
          "path": {"type": "string", "pattern": "^reports/[a-z0-9-]+/[a-z0-9-]+--[a-z]+--\\d{4}-\\d{2}-\\d{2}\\.md$"},
          "project_slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "client": {"type": "string"},
          "audit_firm": {"type": "string"},
          "firm_abbrev": {"type": "string"},
          "report_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "platform": {"type": ["string", "null"]},
          "disclosure_status": {"type": ["string", "null"]},
          "conversion_method": {"type": ["string", "null"]},
          "findings_summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total", "critical", "high", "moderate", "low", "informational"],
            "properties": {
              "total": {"type": "integer", "minimum": 0},
              "critical": {"type": "integer", "minimum": 0},
              "high": {"type": "integer", "minimum": 0},
              "moderate": {"type": "integer", "minimum": 0},
              "low": {"type": "integer", "minimum": 0},
              "informational": {"type": "integer", "minimum": 0}
            }
          },
          "pdf_url": {"type": ["string", "null"]},
          "firm_report_url": {"type": ["string", "null"]}
        }
      }
    }
  }
}
